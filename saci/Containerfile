# Saci worker image for Wanaku test plans (saci/README.md).
#
# It extends the Saci worker image (https://github.com/orpiske/midnight-saci)
# with `wanaku-server`, the `wanaku` CLI and the test MCP server fixture
# (fixtures/test-mcp-server), so a Saci test plan can start the servers and
# drive them with the CLI, `curl` and `jq`. Run from the repository root:
#
#   docker build -f saci/Containerfile -t localhost/wanaku-saci-worker:latest saci
#
# WANAKU_IMAGE supplies `wanaku-server` and FIXTURE_IMAGE supplies the test
# MCP server. The CLI comes from a wanaku-barn release.

ARG SACI_IMAGE=quay.io/orpiske/saci-worker:latest
ARG WANAKU_IMAGE=quay.io/wanaku/wanaku-server:early-access
# A static busybox, used only to extract the CLI archive.
ARG BUSYBOX_IMAGE=docker.io/library/busybox:1.37-musl
ARG FIXTURE_IMAGE=quay.io/wanaku/test-mcp-server:latest

FROM ${WANAKU_IMAGE} AS wanaku
FROM ${BUSYBOX_IMAGE} AS busybox

FROM ${FIXTURE_IMAGE} AS fixture

FROM ${SACI_IMAGE}
ARG TARGETARCH
ARG WANAKU_CLI_RELEASE=early-access
ARG WANAKU_CLI_VERSION=0.3.0-SNAPSHOT
# A version directory under mirror.openshift.com, for example stable-4.19 or 4.19.10.
ARG OC_VERSION=stable
ARG HELM_VERSION=v3.19.0

USER root
COPY --from=wanaku /usr/local/bin/wanaku-server /usr/local/bin/wanaku-server
# The test MCP server listens on port 8181 and serves MCP at /mcp.
COPY --from=fixture --chown=0:0 /deployments/ /opt/test-mcp-server/
RUN printf '#!/bin/sh\nexec java -jar /opt/test-mcp-server/quarkus-run.jar "$@"\n' >/usr/local/bin/test-mcp-server \
    && chmod 0755 /usr/local/bin/test-mcp-server

# The wanaku CLI and wanaku-keycloak-admin come from the same wanaku-barn
# release. Both have native builds for Linux x86_64 only. Other
# architectures use the JVM builds. The JVM builds and the test MCP server
# need Java 21 or later. The launchers find their files relative to their own
# path, so the commands in /usr/local/bin are wrappers, not links.
RUN --mount=type=bind,from=busybox,source=/bin/busybox,target=/tmp/busybox \
    set -eu; \
    programs_to_install="nodejs npm java-headless openssl"; \
    dnf install --assumeyes --setopt=install_weak_deps=False $programs_to_install; \
    dnf clean all; \
    node --version; \
    npx --version; \
    java -version; \
    base="https://github.com/wanaku-ai/wanaku-barn/releases/download/${WANAKU_CLI_RELEASE}"; \
    tmp=$(mktemp -d); \
    curl -fsSL -o "$tmp/checksums_sha256.txt" "$base/checksums_sha256.txt"; \
    install_barn_tool() { \
        dist="$1"; command="$2"; \
        case "${TARGETARCH:-$(uname -m)}" in \
            amd64|x86_64) archive="$dist-${WANAKU_CLI_VERSION}-linux-x86_64.zip"; launcher="bin/$command" ;; \
            *) archive="$dist-${WANAKU_CLI_VERSION}.zip"; launcher="$command" ;; \
        esac; \
        curl -fsSL -o "$tmp/$archive" "$base/$archive"; \
        (cd "$tmp" && grep -F "  $archive" checksums_sha256.txt | sha256sum -c -); \
        /tmp/busybox unzip -q "$tmp/$archive" -d "$tmp/$dist"; \
        mv "$tmp/$dist"/* "/opt/$dist"; \
        chmod -R a+rX,go-w "/opt/$dist"; \
        if [ -d "/opt/$dist/bin" ]; then chmod 0755 "/opt/$dist"/bin/*; fi; \
        chmod 0755 "/opt/$dist/$launcher"; \
        printf '#!/bin/sh\nexec /opt/%s/%s "$@"\n' "$dist" "$launcher" >"/usr/local/bin/$command"; \
        chmod 0755 "/usr/local/bin/$command"; \
    }; \
    install_barn_tool wanaku-cli wanaku; \
    install_barn_tool wanaku-keycloak-admin wanaku-keycloak-admin; \
    rm -rf "$tmp"

# The OpenShift and Helm clients, for plans that deploy to a cluster. The
# OpenShift archive also contains kubectl.
RUN set -eu; \
    case "${TARGETARCH:-$(uname -m)}" in \
        amd64|x86_64) oc_arch=x86_64; helm_arch=amd64 ;; \
        arm64|aarch64) oc_arch=aarch64; helm_arch=arm64 ;; \
        *) echo "unsupported architecture" >&2; exit 1 ;; \
    esac; \
    tmp=$(mktemp -d); \
    oc_base="https://mirror.openshift.com/pub/openshift-v4/${oc_arch}/clients/ocp/${OC_VERSION}"; \
    curl -fsSL -o "$tmp/openshift-client-linux.tar.gz" "$oc_base/openshift-client-linux.tar.gz"; \
    curl -fsSL -o "$tmp/oc-sha256sum.txt" "$oc_base/sha256sum.txt"; \
    (cd "$tmp" && grep -E "  openshift-client-linux\.tar\.gz$" oc-sha256sum.txt | sha256sum -c -); \
    tar -xzf "$tmp/openshift-client-linux.tar.gz" -C /usr/local/bin oc kubectl; \
    helm_archive="helm-${HELM_VERSION}-linux-${helm_arch}.tar.gz"; \
    curl -fsSL -o "$tmp/$helm_archive" "https://get.helm.sh/$helm_archive"; \
    curl -fsSL -o "$tmp/$helm_archive.sha256sum" "https://get.helm.sh/$helm_archive.sha256sum"; \
    (cd "$tmp" && sha256sum -c "$helm_archive.sha256sum"); \
    tar -xzf "$tmp/$helm_archive" -C "$tmp"; \
    install -m 0755 "$tmp/linux-${helm_arch}/helm" /usr/local/bin/helm; \
    chown 0:0 /usr/local/bin/oc /usr/local/bin/kubectl; \
    chmod 0755 /usr/local/bin/oc /usr/local/bin/kubectl; \
    rm -rf "$tmp"; \
    oc version --client; \
    helm version --short; \
    openssl version
USER 10001:0

LABEL org.opencontainers.image.title="wanaku-saci-worker" \
      org.opencontainers.image.description="Saci worker with wanaku-server, the wanaku CLI, wanaku-keycloak-admin, the test MCP server, oc and helm" \
      org.opencontainers.image.source="https://github.com/wanaku-ai/wanaku" \
      org.opencontainers.image.licenses="Apache-2.0"
